FROM node:22-alpine AS build

ARG VITE_API_URL
ARG VITE_HOME_API_URL
ARG VITE_PRODUCT_API_URL
ARG VITE_CART_API_URL
ARG VITE_ORDER_API_URL
ARG VITE_PROFILE_API_URL

ARG VITE_AUTH_FRONTEND_URL
ARG VITE_HOME_FRONTEND_URL
ARG VITE_PRODUCT_FRONTEND_URL
ARG VITE_CART_FRONTEND_URL
ARG VITE_ORDER_FRONTEND_URL
ARG VITE_PROFILE_FRONTEND_URL

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_HOME_API_URL=$VITE_HOME_API_URL
ENV VITE_PRODUCT_API_URL=$VITE_PRODUCT_API_URL
ENV VITE_CART_API_URL=$VITE_CART_API_URL
ENV VITE_ORDER_API_URL=$VITE_ORDER_API_URL
ENV VITE_PROFILE_API_URL=$VITE_PROFILE_API_URL

ENV VITE_AUTH_FRONTEND_URL=$VITE_AUTH_FRONTEND_URL
ENV VITE_HOME_FRONTEND_URL=$VITE_HOME_FRONTEND_URL
ENV VITE_PRODUCT_FRONTEND_URL=$VITE_PRODUCT_FRONTEND_URL
ENV VITE_CART_FRONTEND_URL=$VITE_CART_FRONTEND_URL
ENV VITE_ORDER_FRONTEND_URL=$VITE_ORDER_FRONTEND_URL
ENV VITE_PROFILE_FRONTEND_URL=$VITE_PROFILE_FRONTEND_URL

WORKDIR /frontend-home
ADD . /frontend-home/
RUN npm install && npm run build

FROM nginx:alpine AS runtime
COPY --from=build /frontend-home/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 5174
CMD ["nginx", "-g", "daemon off;"]